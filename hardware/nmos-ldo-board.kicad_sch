	(text "UVLO: U3 holds EN_INT low until VIN rises past about 1.37 V\n(trip point 0.405 V x (1 + R14/R15) = 1.345 V plus 1.5 % hysteresis),\nthen waits 20 ms, 12 to 28 ms (CT open). It trips again below 1.345 V.\nEN low or VIN low: Q2 turns off and EN_N goes high.\nQ3 empties C12, D1 and R13 pull FB up so U1 drives the\ngate low, and Q4 discharges VOUT.\nEN can be left open or pulled low by open drain logic."
		(exclude_from_sim no)
		(at 162.56 248.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "444b9b17-cb74-5357-883f-a61cb9a529e6")
	)
